{
  "name": "gimg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.gimg.desktop",
    "productName": "GIMG",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "vendor/awesome-gpt-image-2-main/data/images",
        "to": "vendor/awesome-gpt-image-2-main/data/images"
      }
    ]
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:electron": "tsc -p tsconfig.node.json && electron .",
    "build": "vite build && tsc -p tsconfig.node.json && node -e \"import{copyFileSync as c}from'fs';c('electron/preload.cjs','dist-electron/preload.cjs')\"",
    "build:electron": "node scripts/build-electron.mjs",
    "dist:dir": "npm run build:electron && electron-builder --dir",
    "dist": "npm run build:electron && electron-builder",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-gallery-workbench-e2e.mjs",
    "test:packaged": "node scripts/capture-packaged-smoke.mjs",
    "test:packaged:persistence": "node scripts/test-packaged-persistence.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "localforage": "^1.10.0",
    "lucide-react": "^0.523.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "^7.9.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.1.9",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.3"
  }
}
